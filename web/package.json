{
  "name": "@mist4k3n/sheets-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser delivery of GenOffice Sheets. Additive-only fork delta; see PLAN.md.",
  "main": "./dist/sheets-web.js",
  "module": "./dist/sheets-web.js",
  "types": "./dist/sheets-web.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sheets-web.d.ts",
      "import": "./dist/sheets-web.js"
    },
    "./style.css": "./dist/sheets-web.css",
    "./package.json": "./package.json",
    "./sheets-frame.html": "./dist/frame/sheets-frame.html"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "npm run build:lib && npm run build:frame && npm run build:types",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:frame": "vite build --config vite.frame.config.ts",
    "build:types": "node tools/build-types.mjs",
    "build:app": "vite build --config vite.config.ts",
    "check:lib": "node tools/check-lib.mjs",
    "check:base": "node tools/check-base.mjs",
    "check:frame": "node tools/check-frame.mjs",
    "check:weight": "node tools/check-weight.mjs",
    "spike": "vite --config vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "api:list": "node tools/list-desktop-api.mjs",
    "check:drift": "node tools/check-drift.mjs",
    "check:channels": "node tools/check-channels.mjs",
    "check:server": "node tools/check-server.mjs",
    "check:mirror": "node tools/check-mirror.mjs",
    "check:host-global": "node tools/check-host-global.mjs",
    "check:upstream": "node tools/check-upstream.mjs",
    "compat": "node tools/compat.mjs",
    "bench": "node tools/bench-range.mjs",
    "bench:memory": "node tools/bench-memory.mjs",
    "bench:linux": "bash tools/bench-container/bench.sh",
    "test": "tsx --test tests/*.test.ts",
    "audit": "node tools/audit-corpus.mjs",
    "spike:encryption": "node tools/spike-encryption.mjs",
    "fidelity": "node tools/fidelity-diff.mjs",
    "visuals": "node tools/probe-visuals.mjs",
    "mock": "node tools/mock-server.mjs",
    "serve": "tsx server/dev-server.ts",
    "harness": "VITE_SHEETS_API=http://127.0.0.1:5274 vite --config vite.config.ts",
    "dev": "VITE_SHEETS_API=http://127.0.0.1:5274 vite --config vite.config.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "@types/node": "^22.20.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "rollup": "^4.63.3",
    "rollup-plugin-dts": "^6.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "ws": "^8.21.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "hono": "^4.13.7",
    "zod": "^4.3.6"
  }
}
