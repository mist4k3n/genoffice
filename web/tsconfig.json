{
  // Standalone rather than extending ../tsconfig.base.json: web/ stays
  // self-contained, and an upstream compiler-option change cannot silently
  // alter this build. The settings below deliberately mirror
  // apps/sheets/tsconfig.json, which is on the DRIFT.md watch list.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@genoffice/file-parse": ["../apps/sheets/src/types/file-parse.d.ts"],
      "@genoffice/docx-engine/math": ["../apps/sheets/src/types/docx-engine-math.d.ts"]
    }
  },
  // Both halves of web/ compile under one config, DOM lib included.
  //
  // A separate DOM-free config for server/ would be better — it would have
  // caught server code referencing `WebSocket`, which typechecked cleanly
  // against a global that does not exist in Node. It is not possible without
  // drift: upstream's shared modules are compiled with DOM by both the main
  // and renderer projects, and `shared/desktop-api.ts` type-imports
  // @genoffice/ui, so a DOM-free compile fails inside upstream's own sources.
  //
  // `npm run check:server` enforces the same rule on our files instead.
  //
  // Only our own sources are listed. Upstream files are pulled in through
  // imports, which is exactly what makes a contract change surface here as a
  // type error.
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "server/**/*.ts",
    "tests/**/*.ts",
    "vite.config.ts",
    // Upstream's ambient declarations for window.desktopApi / window.projectApi.
    // Read, never modified — the renderer we import relies on these globals.
    "../apps/sheets/src/renderer/env.d.ts"
  ]
}
